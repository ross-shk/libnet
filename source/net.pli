 /* net.pli - libnet client + server library, compiled PL/I module. */
 /* */
 /* Module:    net */
 /* Author:    libnet */
 /* Purpose:   The libnet surface as a single compiled PL/I module. */
 /*            The "real" library: connection pool, */
 /*            receive buffering, delimiter scanning, retry loops, */
 /*            timeout and error policy. Callers link against the */
 /*            exported net_* entries and never see the connection */
 /*            layout - they hold only a POINTER handle. */
 /* */
 /* This module uses CONTROLLED storage, char(*), BASED views */
 /* on procedure parameters, based-member access, and */
 /* variable-length SUBSTR. Compiled once into libnet.a, */
 /* connection logic no longer %included inline into each */
 /* program. */
 /* */
 /* Error handling (conditions-only - the idiomatic PL/I mechanism): */
 /*   libnet reports ALL failures via conditions, never return codes.*/
 /*   A returned value is DATA only. A procedure that can fail raises */
 /*   one of: */
 /* */
 /*       condition(net_error)    hard error; oncode() = errno */
 /*       condition(net_timeout)  timeout / EAGAIN;    oncode() = */
 /*                           NET_ERR_TIMEOUT */
 /*       condition(net_eof)      peer closed;         oncode() = */
 /*                           NET_ERR_EOF */
 /*       condition(net_overflow) caller buffer full;  oncode() = */
 /*                           NET_ERR_OVERFLOW */
 /* */
 /* The conditions and NET_ERR_* sentinels are exported so caller */
 /* ON-units reference them (see include/net.inc, which redeclares */
 /* them for the caller's scope). */

net: package exports(net_open, net_connect, net_dial, net_close,
   net_shutdown, net_read, net_read_all, net_read_until, net_write,
   net_send, net_send_all, net_send_once, net_sendto, net_recvfrom,
   net_poll, net_poll_multi, net_set_timeout, net_set_nonblocking, net_setopt,
   net_set_linger, net_peer, net_local, net_resolve, net_strerror,
   net_connect_nb, net_connect_finish, net_listen, net_accept,
   net_server_add_client, net_errtext,
   net_server_nclients, net_server_client, net_server_remove_client);

 /*---------------------------------------------------------------*/
 /* Shared constants (self-contained; the module compiles its own */
 /* copy)                                                        */
 /*---------------------------------------------------------------*/
 %include errno;
 %include type_defs;
 %include c_bridge;

 /*---------------------------------------------------------------*/
 /* Conditions (the only error channel)                          */
 /*---------------------------------------------------------------*/
 dcl net_error    condition;
 dcl net_timeout  condition;
 dcl net_eof      condition;
 dcl net_overflow condition;

 /*---------------------------------------------------------------*/
 /* Private connection record (CONTROLLED, library-owned)        */
 /*---------------------------------------------------------------*/
 /* A connection is a CONTROLLED record. A listening server and an */
 /* accepted client share the same layout. Callers hold only a    */
 /* POINTER handle; each procedure declares a BASED view directly */
 /* on its handle parameter, so no base-pointer copy is needed.  */
 dcl 1 conn_rec controlled unaligned,
    2 fd               fixed bin(31),
    2 is_connected     bit(1),
    2 read_timeout     fixed bin(31),   /* ms; 0 = blocking */
    2 write_timeout    fixed bin(31),   /* ms; 0 = blocking */
    2 peer_ip          char(16),
    2 peer_port        fixed bin(31),
    2 inbuf            char(NET_BUF_CAP),
    2 in_len           fixed bin(31);   /* bytes currently buffered */

 /* Server record with connection pool for multi-client event loop. */
 /* The server's CONTROLLED record includes a fixed array of client */
 /* handles (pointers to conn_rec). NET_MAX_CLIENTS is the max.    */
 dcl 1 server_rec controlled unaligned,
    2 fd               fixed bin(31),
    2 is_connected     bit(1),
    2 read_timeout     fixed bin(31),
    2 write_timeout    fixed bin(31),
    2 peer_ip          char(16),
    2 peer_port        fixed bin(31),
    2 inbuf            char(NET_BUF_CAP),
    2 in_len           fixed bin(31),
    2 n_clients        fixed bin(31),
    2 client_handles   (NET_MAX_CLIENTS) pointer;

 /*---------------------------------------------------------------*/
 /* Internal error helpers (raise conditions - the only error    */
 /* channel)                                                     */
 /*---------------------------------------------------------------*/
 /* Raise net_error with the current errno, unless 0. */
 raise_err: procedure;
   dcl e fixed bin(31);
   e = netc_errno();
   call netc_clearerr();
   if e ^= 0 then signal condition(net_error) set oncode(e);
 end raise_err;

 /* Raise net_timeout (EAGAIN/EINTR/timeout expiry). */
 raise_timeout: procedure;
   signal condition(net_timeout) set oncode(NET_ERR_TIMEOUT);
 end raise_timeout;

 /* Raise net_eof (peer closed / end of stream). */
 raise_eof: procedure;
   signal condition(net_eof) set oncode(NET_ERR_EOF);
 end raise_eof;

 /* Raise net_overflow (caller buffer exhausted mid-stream). */
 raise_overflow: procedure;
   signal condition(net_overflow) set oncode(NET_ERR_OVERFLOW);
 end raise_overflow;

 /*---------------------------------------------------------------*/
 /* Socket validation and error handling helpers                 */
 /*---------------------------------------------------------------*/
 /* Validate socket is open; raise net_error if invalid. */
 validate_socket: procedure (fd);
   dcl fd fixed bin(31);
   if fd <= 0 then signal condition(net_error) set oncode(EBADF);
 end validate_socket;

 /* Check recv result; raise appropriate condition on error/EOF. */
 check_recv: procedure (got, fd) returns (fixed bin(31));
   dcl got fixed bin(31);
   dcl fd  fixed bin(31);
   if got = 0 then call raise_eof();
   else if got < 0 then do;
     if netc_errno() = EAGAIN then call raise_timeout();
     else call raise_err();
   end;
   return (got);
 end check_recv;

 /* Check send result; raise appropriate condition on error. */
 check_send: procedure (n, fd) returns (fixed bin(31));
   dcl n  fixed bin(31);
   dcl fd fixed bin(31);
   if n < 0 then do;
     if netc_errno() = EAGAIN then call raise_timeout();
     else call raise_err();
   end;
   return (n);
 end check_send;

 /* Check C bridge call result; raise net_error on failure. */
 check_rc: procedure (rc);
   dcl rc fixed bin(31);
   if rc < 0 then call raise_err();
 end check_rc;

 /*---------------------------------------------------------------*/
 /* net_open                                                     */
 /*---------------------------------------------------------------*/
 /* Allocate a connection (CONTROLLED push) and create a socket.  */
 /*                                                               */
 /* Returns:  a non-null POINTER handle on success;               */
 /*           the null handle on failure (condition net_error     */
 /*           raised).                                            */
 /*                                                               */
 /* Raises:   condition(net_error) if the socket could not be     */
 /*           created.                                            */
 /*                                                               */
 /* Family:   AF_INET / AF_INET6;  type: SOCK_STREAM / SOCK_DGRAM; */
 /*           proto: IPPROTO_TCP / IPPROTO_UDP / 0.               */
 net_open: procedure (family, type, proto) returns (pointer);
   dcl family fixed bin(31);
   dcl type   fixed bin(31);
   dcl proto  fixed bin(31);
   dcl h      pointer;
   dcl fd     fixed bin(31);

   /* Create socket first */
   fd = netc_socket(family, type, proto);
   if fd < 0 then do;
     call raise_err();
     return (null());
   end;

   /* Allocate and initialize connection record */
   allocate conn_rec;                /* implicit push - CONTROLLED */
   conn_rec.fd            = fd;
   conn_rec.is_connected  = '0'b;
   conn_rec.read_timeout  = 0;
   conn_rec.write_timeout = 0;
   conn_rec.peer_ip       = '';
   conn_rec.peer_port     = 0;
   conn_rec.in_len        = 0;

   h = addr(conn_rec);
   return (h);
 end net_open;

 /*---------------------------------------------------------------*/
 /* net_connect / net_dial                                       */
 /*---------------------------------------------------------------*/
 /* Connect an opened connection to host:port.                    */
 /*                                                               */
 /* Raises:   condition(net_error) on connect failure.            */
 /*                                                               */
 /* Host is a host name or dotted quad; it is resolved via        */
 /* getaddrinfo. On success the peer_* fields are filled.         */
 net_connect: procedure (h, host, port);
   dcl h    pointer;
   dcl 1 c  based(h) like conn_rec;
   dcl host char(NET_HOST_MAX) varying;
   dcl port fixed bin(31);
   dcl rc   fixed bin(31);

   rc = netc_connect(c.fd, host, length(host), port);
   call check_rc(rc);
   c.is_connected = '1'b;
   c.peer_port    = port;
 end net_connect;

 /* Resolve host:port and connect. */
 /*                                                                   */
 /* Returns:  a connection handle in h (null on failure).             */
 /*                                                                   */
 /* Raises:   condition(net_error) on malformed host:port or connect */
 /*           failure.                                                */
 net_dial: procedure (h, hostport, family);
   dcl h        pointer;
   dcl hostport char(NET_HOST_MAX) varying;
   dcl family   fixed bin(31);
   dcl colon    fixed bin(31);
   dcl hoststr  char(NET_HOST_MAX);
   dcl portstr  char(6);
   dcl port     fixed bin(31);

   colon = index(hostport, ':');
   if colon = 0 then do;
     signal condition(net_error) set oncode(EINVAL);
     h = null();
     return;
   end;
   hoststr = substr(hostport, 1, colon - 1);
   portstr = substr(hostport, colon + 1, length(hostport) - colon);
   port    = fixed(trim(portstr));
   h = net_open(family, SOCK_STREAM, 0);
   if h = null() then return;
   call net_connect(h, trim(hoststr), port);
 end net_dial;

 /*---------------------------------------------------------------*/
 /* net_close / net_shutdown                                     */
 /*---------------------------------------------------------------*/
 /* Close connection and free controlled storage.                 */
 net_close: procedure (h);
   dcl h   pointer;
   dcl 1 c based(h) like conn_rec;
   if c.fd > 0 then call netc_close(c.fd);
   c.fd            = 0;
   c.is_connected  = '0'b;
   c.in_len        = 0;
   free conn_rec;                    /* CONTROLLED pop */
 end net_close;

 /* Shut down one direction of the connection.                      */
 /* Raises:   condition(net_error) on failure.                      */
 net_shutdown: procedure (h, how);
   dcl h   pointer;
   dcl 1 c based(h) like conn_rec;
   dcl how fixed bin(31);
   dcl rc  fixed bin(31);
   rc = netc_shutdown(c.fd, how);
   call check_rc(rc);
 end net_shutdown;

 /*---------------------------------------------------------------*/
 /* net_read family                                              */
 /*---------------------------------------------------------------*/
 /* Read up to buflen bytes into buffer.                          */
 /*                                                                   */
 /* Returns:  the number of bytes read (0 <= n <= buffer capacity).   */
 /*                                                                   */
 /* Raises:   condition(net_eof) if the peer closed the stream;       */
 /*           condition(net_timeout) on timeout/EAGAIN;               */
 /*           condition(net_error) on a hard error.                   */
 net_read: procedure (h, buffer) returns (fixed bin(31));
   dcl h      pointer;
   dcl 1 c    based(h) like conn_rec;
   dcl buffer char(NET_BUF_CAP) varying;
   dcl got    fixed bin(31);
   dcl tmp    char(NET_BUF_CAP);

   call validate_socket(c.fd);

   got = netc_recv(c.fd, tmp, NET_BUF_CAP, 0);
   got = check_recv(got, c.fd);
   if got > 0 then buffer = substr(tmp, 1, got);
   return (got);
 end net_read;

 /* Read everything from conn into a dynamically allocated CONTROLLED
    buffer. The caller provides a char(*) varying controlled variable
    which this procedure allocates and grows as needed. No fixed size
    limit - response can be truly arbitrary length.
    conn   : open connection
    buffer : caller's controlled buffer (allocated by this procedure)
    Returns the number of bytes read.
    Raises net_error on hard error, net_timeout on EAGAIN, net_eof on
    peer close. */
 net_read_all: procedure (conn, buffer) returns (fixed bin(31));
   dcl conn    pointer;
   dcl 1 c     based(conn) like conn_rec;
   dcl buffer  char(*) varying controlled;
   dcl cap     fixed bin(31) init(1024);
   dcl spare   char(*) varying controlled;
   dcl chunk   char(NET_BUF_CAP) varying;
   dcl chunk_len fixed bin(31);
   dcl total_len fixed bin(31) init(0);

   call validate_socket(c.fd);

   /* Allocate initial controlled buffer */
   allocate buffer (cap) character varying;

 /* Read in chunks using net_read, growing string as needed */
   do while ('1'b);
     chunk_len = net_read(conn, chunk);
     if chunk_len = 0 then leave;  /* EOF */

     /* Grow: ALLOCATE pushes a fresh generation, so copy buffer
        aside first (FREE would discard the bytes read so far).
        Loop: one chunk can exceed the buffer several times over */
     do while (total_len + chunk_len > cap);
       cap = cap * 2;
       allocate spare (cap) character varying;
       spare = buffer;
       free buffer;
       allocate buffer (cap) character varying;
       buffer = spare;
       free spare;
     end;

     /* Append chunk to buffer using SUBSTR assignment */
     substr(buffer, total_len + 1, chunk_len) =
       substr(chunk, 1, chunk_len);
     total_len = total_len + chunk_len;
   end;

   /* Trim buffer to actual length if we overallocated */
   if total_len < cap then do;
     if total_len > 0 then do;
       allocate spare (total_len) character varying;
       spare = buffer;
       free buffer;
       allocate buffer (total_len) character varying;
       buffer = spare;
       free spare;
     end;
     else do;
       free buffer;
       allocate buffer (0) character varying;
     end;
   end;

   return (total_len);
 end net_read_all;

 /* Read until a delimiter character is seen, appending               */
 /* received bytes to buffer.                                         */
 /*                                                                   */
 /* Returns:  the position of the first delimiter in buffer (1..len). */
 /*                                                                   */
 /* Raises:   condition(net_eof) if peer closed before delimiter;     */
 /*           condition(net_timeout), condition(net_error), or        */
 /*           condition(net_overflow) if the caller buffer filled.    */
 net_read_until: procedure (h, buffer, delim) returns (fixed bin(31));
   dcl h      pointer;
   dcl 1 c    based(h) like conn_rec;
   dcl buffer char(NET_BUF_CAP) varying;
   dcl delim  char(1);
   dcl total  fixed bin(31);
   dcl pos    fixed bin(31);
   dcl got    fixed bin(31);
   dcl tmp    char(NET_BUF_CAP);
   dcl cap    fixed bin(31);
   dcl done   bit(1);

   call validate_socket(c.fd);

   total = length(buffer);
   done  = '0'b;
   do while (^done);
     cap = NET_BUF_CAP - total;
     if cap <= 0 then do;   /* caller buffer full, no delimiter */
       call raise_overflow();
       return (0);
     end;
     got = netc_recv(c.fd, tmp, cap, 0);
     got = check_recv(got, c.fd);
     if got <= 0 then return (0);

     /* Append the new bytes after any content already in buffer */
     if total = 0 then buffer = substr(tmp, 1, got);
     else buffer = substr(buffer, 1, total) || substr(tmp, 1, got);
     total  = total + got;
     pos = index(buffer, delim);
     if pos > 0 then return (pos);
   end; /* do while */
   return (0);
 end net_read_until;

 /*-------------------------------------------------------------------*/
 /* net_write / net_send family                                       */
 /*-------------------------------------------------------------------*/
 /* Send buffer verbatim (flags = 0).                                 */
 /*                                                                   */
 /* Returns:  the number of bytes sent (0 <= n <= length(buffer)).    */
 /*                                                                   */
 /* Raises:   condition(net_timeout) on timeout/EAGAIN;               */
 /*           condition(net_error) on a hard error.                   */
 net_write: procedure (h, buffer) returns (fixed bin(31));
   dcl h      pointer;
   dcl 1 c    based(h) like conn_rec;
   dcl buffer char(NET_BUF_CAP) varying;
   dcl n      fixed bin(31);

   n = netc_send(c.fd, buffer, length(buffer), 0);
   return (check_send(n, c.fd));
 end net_write;

 net_send: procedure (h, buffer, flags) returns (fixed bin(31));
   dcl h      pointer;
   dcl 1 c    based(h) like conn_rec;
   dcl buffer char(NET_BUF_CAP) varying;
   dcl flags  fixed bin(31);
   dcl n      fixed bin(31);

   n = netc_send(c.fd, buffer, length(buffer), flags);
   return (check_send(n, c.fd));
 end net_send;

 /* Send the whole buffer, retrying on partial sends.                 */
 /*                                                                   */
 /* Returns:  the total number of bytes sent.                         */
 /*                                                                   */
 /* Raises:   condition(net_error) on a hard (non-EAGAIN) error.      */
 net_send_all: procedure (h, buffer) returns (fixed bin(31));
   dcl h      pointer;
   dcl 1 c    based(h) like conn_rec;
   dcl buffer char(NET_BUF_CAP) varying;
   dcl total  fixed bin(31);
   dcl want   fixed bin(31);
   dcl n      fixed bin(31);
   dcl chunk  char(NET_BUF_CAP) varying;
   dcl take   fixed bin(31);

   total = 0;
   want  = length(buffer);
   do while (total < want);
     take  = min(NET_BUF_CAP, want - total);
     chunk = substr(buffer, total + 1, take);
     n = net_send(h, chunk, 0);
     total = total + n;
   end; /* do while */

   return (total);
 end net_send_all;

 /* A single send() with optional flags; no retry.                    */
 /*                                                                   */
 /* Returns:  the number of bytes sent.                               */
 /*                                                                   */
 /* Raises:   condition(net_timeout) / condition(net_error).          */
 net_send_once: procedure (h, buffer, flags) returns (fixed bin(31));
   dcl h      pointer;
   dcl 1 c    based(h) like conn_rec;
   dcl buffer char(NET_BUF_CAP) varying;
   dcl flags  fixed bin(31);
   dcl n      fixed bin(31);

   n = netc_send(c.fd, buffer, length(buffer), flags);
   return (check_send(n, c.fd));
 end net_send_once;

 /*-------------------------------------------------------------------*/
 /* net_poll / net_set_timeout / net_set_nonblocking                  */
 /*-------------------------------------------------------------------*/
 /* Poll for readiness.                                               */
 /*                                                                   */
 /* Returns:  the ready mask (POLLIN/POLLOUT), or 0 on timeout. A     */
 /*           timeout is NOT an error for poll - it is the normal     */
 /*           "nothing ready" result.                                 */
 /*                                                                   */
 /* Raises:   condition(net_error) on a hard error.                   */
 net_poll: procedure (h, events, ms) returns (fixed bin(31));
   dcl h      pointer;
   dcl 1 c    based(h) like conn_rec;
   dcl events fixed bin(31);
   dcl ms     fixed bin(31);
   dcl r      fixed bin(31);

   r = netc_poll(c.fd, events, ms);
   call check_rc(r);
   return (r);
 end net_poll;

 /* Multi-fd poll across a server's connection pool.                  */
 /*                                                                   */
 /* server   - server handle (from net_listen)                        */
 /* events   - array of event masks to watch per fd (extent           */
 /*            n_clients+1). Index 1 is the server socket, indices    */
 /*            2..n_clients+1 are the pool entries.                   */
 /*            (POLLIN=1, POLLOUT=2). Caller allocates as             */
 /*            fixed bin(31) controlled with dimension n_clients+1.   */
 /* revents  - array of returned event masks (same codes + 4=error)   */
 /* ms       - timeout in milliseconds (-1 = infinite)                */
 /*                                                                   */
 /* Returns:  the number of ready fds, or 0 on timeout.               */
 /*           On error raises condition(net_error).                   */
 /*                                                                   */
 /* The server's client pool is used; events/revents arrays must have */
 /* at least s.n_clients+1 elements. Index 1 = server socket,         */
 /* indices 2..n_clients+1 = the pool entries.                        */
 net_poll_multi: procedure (server, events, revents, ms)
     returns (fixed bin(31));
   dcl server  pointer;
   dcl events  fixed bin(31) controlled;
   dcl revents fixed bin(31) controlled;
   dcl ms      fixed bin(31);
   dcl 1 s     based(server) like server_rec;
   dcl fds     fixed bin(31) controlled;
   dcl r       fixed bin(31);
   dcl i       fixed bin(31);
   dcl n       fixed bin(31);
   dcl 1 c     based like conn_rec;

   n = s.n_clients + 1;  /* +1 for server socket */
   if s.n_clients <= 0 then return (0);

   allocate fds (n);
   /* Index 1 = server socket */
   fds(1) = s.fd;
   /* Indices 2..n_clients+1 = client connections */
   do i = 1 to s.n_clients;
     fds(i + 1) = s.client_handles(i) -> c.fd;
   end;

   r = netc_poll_multi(addr(fds(1)), addr(events(1)),
                       addr(revents(1)), n, ms);

   free fds;

   if r < 0 then call raise_err();

   return (r);
 end net_poll_multi;

 /* Set read/write timeouts (ms; 0 = blocking).                       */
 /* Raises:   condition(net_error) on failure.                        */
 net_set_timeout: procedure (h, rto, wto);
   dcl h   pointer;
   dcl 1 c based(h) like conn_rec;
   dcl rto fixed bin(31);
   dcl wto fixed bin(31);
   dcl rc  fixed bin(31);

   rc = netc_settimeout(c.fd, rto, wto);
   call check_rc(rc);

   c.read_timeout  = rto;
   c.write_timeout = wto;
 end net_set_timeout;

 /* Enable or disable nonblocking I/O.                                */
 /* Raises:   condition(net_error) on failure.                        */
 net_set_nonblocking: procedure (h, on);
   dcl h  pointer;
   dcl 1 c based(h) like conn_rec;
   dcl on bit(1);
   dcl rc fixed bin(31);

   if on then rc = netc_setnonblock(c.fd, 1);
   else       rc = netc_setnonblock(c.fd, 0);

   call check_rc(rc);
 end net_set_nonblocking;

 /*-------------------------------------------------------------------*/
 /* net_setopt                                                        */
 /*-------------------------------------------------------------------*/
 /* Set a socket option by libnet code (NETOPT_REUSEADDR /            */
 /* NETOPT_KEEPALIVE / NETOPT_NODELAY). value is 0 (off) or 1 (on).   */
 /* Raises:   condition(net_error) on failure.                        */
 net_setopt: procedure (h, opt, value);
   dcl h     pointer;
   dcl 1 c   based(h) like conn_rec;
   dcl opt   fixed bin(31);
   dcl value fixed bin(31);
   dcl rc    fixed bin(31);

   rc = netc_sockopt(c.fd, opt, value);
   call check_rc(rc);
 end net_setopt;

 /* SO_LINGER: enable/disable with a timeout in seconds.              */
 /* Raises:   condition(net_error) on failure.                        */
 net_set_linger: procedure (h, on, seconds);
   dcl h       pointer;
   dcl 1 c     based(h) like conn_rec;
   dcl on      fixed bin(31);
   dcl seconds fixed bin(31);
   dcl rc      fixed bin(31);

   rc = netc_setlinger(c.fd, on, seconds);
   call check_rc(rc);
 end net_set_linger;

 /*-------------------------------------------------------------------*/
 /* net_peer / net_local                                              */
 /*-------------------------------------------------------------------*/
 /* Fill ip/port with the peer (remote) address.                      */
 /* Raises:   condition(net_error) on failure.                        */
 net_peer: procedure (h, ip, port);
   dcl h    pointer;
   dcl 1 c  based(h) like conn_rec;
   dcl ip   char(16) varying;
   dcl port fixed bin(31);
   dcl rc   fixed bin(31);
   dcl tmp  char(16);

   rc = netc_getpeername(c.fd, tmp, 16, addr(port));
   call check_rc(rc);
   ip = trim(tmp);
 end net_peer;

 /* Fill ip/port with the local (bound) address.                      */
 /* Raises:   condition(net_error) on failure.                        */
 net_local: procedure (h, ip, port);
   dcl h    pointer;
   dcl 1 c  based(h) like conn_rec;
   dcl ip   char(16) varying;
   dcl port fixed bin(31);
   dcl rc   fixed bin(31);
   dcl tmp  char(16);

   rc = netc_getsockname(c.fd, tmp, 16, addr(port));
   call check_rc(rc);
   ip = trim(tmp);
 end net_local;

 /*-------------------------------------------------------------------*/
 /* net_resolve                                                       */
 /*-------------------------------------------------------------------*/
 /* Resolve a host name (or dotted quad) to a dotted-quad string      */
 /* in ip.                                                            */
 /* Raises:   condition(net_error) on resolution failure.             */
 net_resolve: procedure (host, ip);
   dcl host char(NET_HOST_MAX) varying;
   dcl ip   char(16) varying;
   dcl rc   fixed bin(31);
   dcl tmp  char(16);

   rc = netc_resolve(host, length(host), tmp, 16);
   call check_rc(rc);
   ip = trim(tmp);
 end net_resolve;

 /*-------------------------------------------------------------------*/
 /* net_strerror                                                      */
 /*-------------------------------------------------------------------*/
 /* Human-readable text for an errno value, into buf.                 */
 net_strerror: procedure (e, buf);
   dcl e   fixed bin(31);
   dcl buf char(NET_BUF_CAP) varying;
   dcl tmp char(NET_BUF_CAP);

   call netc_strerror(e, tmp, NET_BUF_CAP);
   buf = trim(tmp);
 end net_strerror;

 /*-------------------------------------------------------------------*/
 /* net_connect_nb                                                    */
 /*-------------------------------------------------------------------*/
 /* Start a nonblocking connect (the fd is made nonblocking). If      */
 /* the connect completes immediately, is_connected is set. If it     */
 /* is still in progress, the procedure simply returns - the caller   */
 /* polls for writability and then calls net_connect_finish. No       */
 /* condition is raised for in-progress (it is not an error).         */
 /*                                                                   */
 /* Raises:   condition(net_error) on a hard connect failure.         */
 net_connect_nb: procedure (h, host, port);
   dcl h    pointer;
   dcl 1 c  based(h) like conn_rec;
   dcl host char(NET_HOST_MAX) varying;
   dcl port fixed bin(31);
   dcl rc   fixed bin(31);

   call netc_setnonblock(c.fd, 1);

   rc = netc_connect_nb(c.fd, host, length(host), port);
   if rc = 0 then do;
     c.is_connected = '1'b;
     c.peer_port    = port;
     return;
   end;
   if rc = -1 then do;                 /* EINPROGRESS */
     call netc_clearerr();
     return;
   end;
   call raise_err();
 end net_connect_nb;

 /* Finalize a nonblocking connect after the fd became writable.      */
 /* Raises:   condition(net_error) if the connect ultimately failed.  */
 net_connect_finish: procedure (h);
   dcl h  pointer;
   dcl 1 c based(h) like conn_rec;
   dcl e  fixed bin(31);
   dcl rc fixed bin(31);

   e = 0;
   rc = netc_getsockerr(c.fd, addr(e));
   call check_rc(rc);

   if e ^= 0 then do;
     signal condition(net_error) set oncode(e);
     return;
   end;

   c.is_connected = '1'b;
 end net_connect_finish;

 /*-------------------------------------------------------------------*/
 /* UDP datagrams                                                     */
 /*-------------------------------------------------------------------*/
 /* Send a datagram to ip:port on this (datagram) connection.         */
 /*                                                                   */
 /* Returns:  the number of bytes sent.                               */
 /*                                                                   */
 /* Raises:   condition(net_timeout) on EAGAIN; condition(net_error)  */
 /*           otherwise.                                              */
 net_sendto: procedure (h, buffer, ip, port) returns (fixed bin(31));
   dcl h      pointer;
   dcl 1 c    based(h) like conn_rec;
   dcl buffer char(NET_BUF_CAP) varying;
   dcl ip     char(16) varying;
   dcl port   fixed bin(31);
   dcl n      fixed bin(31);

   n = netc_sendto(c.fd, buffer, length(buffer), 0,
                   ip, length(ip), port);
   return (check_send(n, c.fd));
 end net_sendto;

 /* Receive a datagram; the sender's address is returned in ip/port.  */
 /*                                                                   */
 /* Returns:  the number of bytes received.                           */
 /*                                                                   */
 /* Raises:   condition(net_timeout) on EAGAIN; condition(net_error)  */
 /*           otherwise.                                              */
 net_recvfrom: procedure (h, buffer, ip, port) returns (fixed bin(31));
   dcl h      pointer;
   dcl 1 c    based(h) like conn_rec;
   dcl buffer char(NET_BUF_CAP) varying;
   dcl ip     char(16) varying;
   dcl port   fixed bin(31);
   dcl n      fixed bin(31);
   dcl rbuf   char(NET_BUF_CAP);
   dcl raddr  char(16);

   n = netc_recvfrom(c.fd, rbuf, NET_BUF_CAP, 0, raddr, 16, addr(port));
   if n < 0 then do;
     if netc_errno() = EAGAIN then call raise_timeout();
     else call raise_err();
     return (0);
   end;

   /* A zero-length datagram is valid data, not EOF */
   if n > 0 then buffer = substr(rbuf, 1, n);
   else buffer = '';
   ip = trim(raddr);

   return (n);
 end net_recvfrom;

 /*-------------------------------------------------------------------*/
 /* Server API: net_listen / net_accept                               */
 /*-------------------------------------------------------------------*/
 /* Bind to port and listen. Returns a server handle (POINTER).       */
 net_listen: procedure (port, backlog) returns (pointer);
   dcl port    fixed bin(31);
   dcl backlog fixed bin(31);
   dcl fd      fixed bin(31);
   dcl h       pointer;

   fd = netc_socket(AF_INET, SOCK_STREAM, 0);
   if fd < 0 then do;
     call raise_err();
     return (null());
   end;

   if netc_bind(fd, port) < 0 then do;
     call raise_err();
     call netc_close(fd);
     return (null());
   end;

   if netc_listen(fd, backlog) < 0 then do;
     call raise_err();
     call netc_close(fd);
     return (null());
   end;

   /* Make server socket non-blocking for use with poll() */
   call netc_setnonblock(fd, 1);

   allocate server_rec;
   server_rec.fd            = fd;
   server_rec.is_connected  = '1'b;
   server_rec.read_timeout  = 0;
   server_rec.write_timeout = 0;
   server_rec.peer_ip       = '';
   server_rec.peer_port     = 0;
   server_rec.in_len        = 0;
   server_rec.n_clients     = 0;
   h = addr(server_rec);

   return (h);
 end net_listen;

 /* Add a client connection to the server's pool.
  * Returns the client handle in `client`.
  * Raises: condition(net_error) if pool is full. */
 net_server_add_client: procedure (server, client);
   dcl server pointer;
   dcl client pointer;
   dcl 1 s    based(server) like server_rec;
   dcl cfd    fixed bin(31);

   cfd = netc_accept(s.fd);
   if cfd < 0 then do;
     call raise_err();
     return;
   end;

   if s.n_clients >= NET_MAX_CLIENTS then do;
     call netc_close(cfd);
     signal condition(net_error) set oncode(EMFILE);
     return;
   end;

   allocate conn_rec;
   conn_rec.fd            = cfd;
   conn_rec.is_connected  = '1'b;
   conn_rec.read_timeout  = 0;
   conn_rec.write_timeout = 0;
   conn_rec.peer_ip       = '';
   conn_rec.peer_port     = 0;
   conn_rec.in_len        = 0;
   client = addr(conn_rec);

   s.n_clients = s.n_clients + 1;
   s.client_handles(s.n_clients) = client;
 end net_server_add_client;

 /* Accept one connection on the server handle. Allocates a client    */
 /* connection and sets its handle in `client`.                       */
 /*                                                                   */
 /* Raises:   condition(net_error) on a failed accept; `client` is    */
 /*           left unset.                                             */
 /* Note: This is the legacy single-client accept. For multi-client, */
 /* use net_server_add_client.                                        */
 net_accept: procedure (server, client);
   dcl server pointer;
   dcl client pointer;
   dcl 1 s    based(server) like conn_rec;
   dcl cfd    fixed bin(31);

   cfd = netc_accept(s.fd);
   if cfd < 0 then do;
     call raise_err();
     return;
   end;

   allocate conn_rec;
   conn_rec.fd            = cfd;
   conn_rec.is_connected  = '1'b;
   conn_rec.read_timeout  = 0;
   conn_rec.write_timeout = 0;
   conn_rec.peer_ip       = '';
   conn_rec.peer_port     = 0;
   conn_rec.in_len        = 0;
   client = addr(conn_rec);
 end net_accept;

 /*-------------------------------------------------------------------*/
 /* net_errtext                                                       */
 /*-------------------------------------------------------------------*/
 /* Translate the current oncode() into a human-readable string.      */
 net_errtext: procedure returns (char(32));
   dcl e fixed bin(31);

   e = oncode();
   if e = 0        then return ('success');
   if e = NET_ERR_EOF       then return ('end of stream');
   if e = NET_ERR_TIMEOUT   then return ('timeout');
   if e = NET_ERR_OVERFLOW  then return ('buffer overflow');
   select;
     when (e = EINTR)         return ('interrupted');
     when (e = EBADF)         return ('bad file descriptor');
     when (e = EAGAIN)        return ('try again (EAGAIN)');
     when (e = EACCES)        return ('permission denied');
     when (e = EFAULT)        return ('bad address');
     when (e = EINVAL)        return ('invalid argument');
     when (e = EPIPE)         return ('broken pipe');
     when (e = ENOTCONN)      return ('not connected');
     when (e = ECONNRESET)    return ('connection reset');
     when (e = ETIMEDOUT)     return ('connection timed out');
     when (e = ECONNREFUSED)  return ('connection refused');
     when (e = EHOSTUNREACH)  return ('host unreachable');
     when (e = ENETUNREACH)   return ('network unreachable');
     otherwise                return ('errno ' || char(e));
   end; /* select */
end net_errtext;

  /*-------------------------------------------------------------------*/
  /* Server pool accessors (opaque handle API)                         */
  /*-------------------------------------------------------------------*/
  /* Return number of connected clients. */
  net_server_nclients: procedure (server) returns (fixed bin(31));
    dcl server pointer;
    dcl 1 s based(server) like server_rec;
    return (s.n_clients);
  end net_server_nclients;

  /* Return client handle at index i (1..n_clients). */
  net_server_client: procedure (server, i) returns (pointer);
    dcl server pointer;
    dcl i    fixed bin(31);
    dcl 1 s  based(server) like server_rec;
    if i < 1 | i > s.n_clients then return (null());
    return (s.client_handles(i));
  end net_server_client;

  /* Remove client at index i and compact pool. */
  net_server_remove_client: procedure (server, i);
    dcl server pointer;
    dcl i    fixed bin(31);
    dcl 1 s  based(server) like server_rec;
    dcl j    fixed bin(31);
    if i < 1 | i > s.n_clients then return;
    call net_close(s.client_handles(i));
    do j = i to s.n_clients - 1;
      s.client_handles(j) = s.client_handles(j + 1);
    end;
    s.n_clients = s.n_clients - 1;
  end net_server_remove_client;

  end net;
