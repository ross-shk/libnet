 net: package exports(net_connect, net_dial, net_send, net_recv,
   net_read, net_read_all, net_write, net_write_all, net_close, net_shutdown, 
   net_open, net_resolve, net_poll, net_set_nonblocking, net_set_default);

 %include c_bridge;
 %include net_errors;
 %include net_helpers;

 net_open: proc(conn, family, socktype, flag);
   dcl conn like conncb;
   dcl (family, socktype, flag) fixed bin(31);

   /* create socket */
   conn.fd = c_socket(family, socktype, flag);
   /* handle socket error */
   if conn.fd < 0 then do;
     signal condition(neterror) set oncode(c_get_errno());
     return;
   end;
   /* init conncb fields */
   conn.addr_family = family;
   conn.sock_type = socktype;
   conn.flags = flag;
   conn.read_timeout = 0;
   conn.write_timeout = 0;
 end net_open;

 net_connect: proc(conn, ip, port);
   dcl conn like conncb;
   dcl ip char(*) varying;
   dcl port port_t;

   begin;
     dcl status fixed bin(31);
     dcl c_ip char(257);

     /* apply connect timeout */
     call apply_timeout(conn, 0);

     /* build c string and connect */
     c_ip = trim(substr(ip, 1, length(ip))) || '00'x;
     status = c_connect(addr(c_ip), port, conn.fd, conn.addr_family);
     /* handle connect error */
     if status < 0 then do;
       signal condition(neterror) set oncode(c_get_errno());
       return;
     end;
   end;
    
   /* update conncb on success */
   conn.host_name = ip;
   conn.port = port;
   conn.is_connected = '1'b;
 end net_connect;

 net_dial: proc(conn, url, family);
   dcl conn like conncb;
   dcl url char(*) varying;
   dcl family fixed bin(31);
   
   dcl host char(256) varying;
   dcl port port_t;
   /* parse url into host and port */
   call split_url;

   /* open socket and connect based on host type */
   call net_open(conn, family, SOCK_TYPE.STREAM, 0);
   if is_hostname then do;
     call net_resolve(conn, host);
     call net_connect(conn, conn.ip_addr, port);
   end;
   else
     call net_connect(conn, host, port);

   split_url: proc;
     dcl pos fixed bin(31);
     /* find colon separator */
     pos = index(url, ':');

     /* handle missing colon */
     if pos = 0 then do;
       signal condition(neterror) set oncode(61);
       return;
     end;
     else do;
       host = substr(url, 1, pos-1);
       port = fixed(substr(url, pos+1));
     end;
   end;

  is_hostname: proc returns(bit(1));
      dcl letters char(52) init(
        'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz');
      /* check if host contains letters */
      return( verify(reverse(host), letters) > 1 );
    end;
 end net_dial;

 net_send: proc(conn, request, flags) returns(size_t);
   dcl conn like conncb;
   dcl request char(*) varying;
   dcl flags flags_t;

   dcl bytes_sent fixed bin(31) init(0);

   /* apply write timeout */
   call apply_timeout(conn, 0);

   /* send via c layer */
   begin;
     dcl slice char(length(request));
     /* prepare slice and send */
     slice = request;
     bytes_sent = c_send(conn.fd, addr(slice), length(request), flags);
   end;

   /* handle send error */
   if bytes_sent < 0 then do;
     if c_get_errno() = 11 | c_get_errno() = 35 then do;
       if mod(flags, 128) >= 64 | mod(conn.flags, 4096) >= 2048 then
         return(0);
     end;
     signal condition(neterror) set oncode(c_get_errno());
   end;
   return(bytes_sent);
 end net_send;

 net_recv: proc(conn, response, flags) returns(size_t);
   dcl conn like conncb;
   dcl response char(*);   
   dcl flags flags_t;

   dcl bytes_received fixed bin(31) init(0);

   /* apply read timeout */
   call apply_timeout(conn, 1);

   /* receive via c layer */
   bytes_received = c_receive(conn.fd, addr(response), 
      length(response), flags);
   /* handle receive error */
   if bytes_received < 0 then do;
     if c_get_errno() = 11 | c_get_errno() = 35 then do;
       if mod(flags, 128) >= 64 | mod(conn.flags, 4096) >= 2048 then
         return(0);
     end;
     signal condition(neterror) set oncode(c_get_errno());
     return(bytes_received);
   end;
   /* truncate buffer to actual bytes */
   if bytes_received > 0 then 
      response = substr(response, 1, bytes_received);
   return(bytes_received);
 end net_recv; 

 net_write_all: proc(conn, buffer) returns(size_t);
   dcl conn like conncb;
   dcl buffer char(*) varying;

   dcl bytes_written fixed bin(31) init(0);

   /* apply write timeout */
   call apply_timeout(conn, 0);

   /* loop until all bytes written */
   begin;
     dcl n size_t;
     dcl slice char(length(buffer));

     /* prepare slice and loop */
     slice = buffer;

     do while(bytes_written < length(buffer));
      n = c_write(conn.fd, addr(slice) + bytes_written,
                    length(buffer) - bytes_written);
        /* handle short write */
        if n <= 0 then leave;
        bytes_written = bytes_written + n;
      end;
    end;

   /* handle write error */
    if bytes_written < 0 then do;
      signal condition(neterror) set oncode(c_get_errno());
      return(bytes_written);
    end;
   return(bytes_written);
 end net_write_all;

 net_write: proc(conn, buffer) returns(size_t);
   dcl conn like conncb;
   dcl buffer char(*) varying;

   dcl n size_t;
   dcl slice char(length(buffer));

   /* apply write timeout */
   call apply_timeout(conn, 0);

   /* single write */
   slice = buffer;
   n = c_write(conn.fd, addr(slice), length(buffer));

   /* handle write error */
   if n < 0 then do;
     if c_get_errno() = 11 | c_get_errno() = 35 then do;
       if mod(conn.flags, 4096) >= 2048 then
         return(0);
     end;
     signal condition(neterror) set oncode(c_get_errno());
     return(n);
   end;
   return(n);
 end net_write;

 net_read: proc(conn, buffer) returns(size_t);
   dcl conn like conncb;
   dcl buffer char(*);
   dcl bytes_read size_t;

   /* apply read timeout */
   call apply_timeout(conn, 1);

   /* single read */
   bytes_read = c_read(conn.fd, addr(buffer), length(buffer));

   /* handle read error */
   if bytes_read < 0 then do;
     if c_get_errno() = 11 | c_get_errno() = 35 then do;
       if mod(conn.flags, 4096) >= 2048 then
         return(0);
     end;
     signal condition(neterror) set oncode(c_get_errno());
     return(bytes_read);
   end;
   /* truncate buffer to actual bytes */
   if bytes_read > 0 then 
      buffer = substr(buffer, 1, bytes_read);
   return(bytes_read);
 end net_read;

 net_read_all: proc(conn, buffer) returns(size_t);
   dcl conn like conncb;
   dcl buffer char(*);

   dcl total_read size_t init(0);

   /* apply read timeout */
   call apply_timeout(conn, 1);

   /* loop until buffer full or eof */
   begin;
     dcl buf_ptr ptr;
     buf_ptr = addr(buffer);
     dcl n size_t;

     do while(total_read < length(buffer));
       n = c_read(conn.fd, buf_ptr + total_read,
                length(buffer) - total_read);
       /* handle read error */
       if n < 0 then do;
         signal condition(neterror) set oncode(c_get_errno());
         return(n);
       end;
       /* handle eof */
       if n = 0 then leave;
       total_read = total_read + n;
     end;
   end;

   /* truncate buffer to actual bytes */
   if total_read > 0 then
     buffer = substr(buffer, 1, total_read);
   return(total_read);
 end net_read_all;

 net_close: proc(conn) returns(fixed bin(31));
   dcl conn like conncb;

   dcl err_code fixed bin(31) init(0);
   
   /* close if valid fd */
   if conn.fd >= 0 then do;
     err_code = c_close(conn.fd);
     if err_code < 0 then do;
       signal condition(neterror) set oncode(c_get_errno());
       return(err_code);
     end;
     conn.is_connected = '0'b;
   end;
   return(err_code);
 end net_close;

 net_shutdown: proc(conn, how) returns(fixed bin(31));
   dcl conn like conncb;
   dcl how shut_how_t;
   dcl err fixed bin(31);

   /* shutdown socket */
   err = c_shutdown(conn.fd, how);
   if err < 0 then do;
     signal condition(neterror) set oncode(c_get_errno());
     return(err);
   end;
   return(err);
 end net_shutdown;

 net_resolve: proc(conn, hostname);
   dcl conn like conncb;
   dcl hostname char(*) varying;

   dcl ip_buf char(64) init((64)'00'x); 
   dcl c_host char(257);
   dcl rc fixed bin(31);
   dcl null_pos fixed bin(31);

    /* resolve hostname to ip */
   begin;
     c_host = substr(hostname, 1, length(hostname)) || '00'x;
     rc = c_resolve_hostname(addr(c_host), conn.addr_family, 
       addr(ip_buf), length(ip_buf));

     if rc < 0 then do;
       signal condition(neterror) set oncode(c_get_errno());
       return;
     end;
   end;

   /* extract ip from c buffer */
   null_pos = index(ip_buf, '00'x);
   if null_pos = 0 then null_pos = length(ip_buf) + 1;
   
   conn.host_name = trim(substr(hostname, 1, length(hostname)));
   conn.ip_addr = substr(ip_buf, 1, null_pos - 1);
 end net_resolve;

 net_poll: proc(conn, timeout, events) returns(fixed bin(31));
   dcl conn like conncb;
   dcl (timeout, events) fixed bin(31);
   dcl revents fixed bin(31);

   /* poll single fd, EINTR retry in C, 0 timeout, -1 error */
   revents = c_poll(conn.fd, timeout, events);
   if revents < 0 then do;
     signal condition(neterror) set oncode(c_get_errno());
     return(revents);
   end;
   return(revents);
 end net_poll;

 net_set_nonblocking: proc(conn);
   dcl conn like conncb;
   dcl rc fixed bin(31);
   rc = c_set_nonblocking(conn.fd, 1);
   if rc < 0 then do;
     signal condition(neterror) set oncode(c_get_errno());
     return;
   end;
   if mod(conn.flags, 4096) < 2048 then
     conn.flags = conn.flags + SOCK_FLAGS.NONBLOCK;
   return;
 end net_set_nonblocking;

 net_set_default: proc(conn);
   dcl conn like conncb;
   dcl rc fixed bin(31);
   rc = c_set_nonblocking(conn.fd, 0);
   if rc < 0 then do;
     signal condition(neterror) set oncode(c_get_errno());
     return;
   end;
   if mod(conn.flags, 4096) >= 2048 then
     conn.flags = conn.flags - SOCK_FLAGS.NONBLOCK;
   return;
 end net_set_default;

 end net;