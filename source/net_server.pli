 net: package exports(net_listen, net_accept);

  %include c_bridge;
  %include net_errors;

  /* helper: apply read/write timeout from conncb */
 apply_timeout: proc(conn, is_read);
   dcl conn like conncb;
   dcl is_read fixed bin(31);
   dcl rc fixed bin(31);
   if is_read then do;
     if conn.read_timeout ^= 0 then
       rc = c_set_timeout(conn.fd, 1, conn.read_timeout);
     else rc = c_set_timeout(conn.fd, 1, 0);
   end;
   else do;
     if conn.write_timeout ^= 0 then
       rc = c_set_timeout(conn.fd, 0, conn.write_timeout);
     else rc = c_set_timeout(conn.fd, 0, 0);
   end;
 end apply_timeout;

 net_listen: proc(conn, port, backlog);
   dcl conn    like conncb;
   dcl port    port_t;
   dcl backlog backlog_t;

    /* bind socket */
    if c_bind(conn.fd, port, conn.addr_family, INADDR.ANY) < 0 then do;
      signal condition(neterror) set oncode(c_get_errno());
      return;
    end;

    /* listen */
    if c_listen(conn.fd, backlog) < 0 then do;
      signal condition(neterror) set oncode(c_get_errno());
      return;
    end;

    /* update conncb */
    conn.port = port;
    conn.is_connected = '1'b;
 end net_listen;

 net_accept: proc(server, client) returns(fixed bin(31));
   dcl server like conncb;
   dcl client like conncb;
   dcl client_fd sock_fd_t;

   /* apply accept timeout */
   call apply_timeout(server, 1);

   /* accept client */
   client_fd = c_accept(server.fd);
   if client_fd < 0 then do;
     signal condition(neterror) set oncode(c_get_errno());
     return;
   end;

   /* init client conncb */
   client.fd = client_fd;
   client.is_connected = '1'b;
   client.read_timeout = 0;
   client.write_timeout = 0;
 end net_accept;

 end net;