 main: proc options(main);
 %include net;

   /* fixture: single-client echo/http server for e2e tests */
   dcl server like conncb;
   dcl client like conncb;
   dcl port port_t init(18080);
   dcl backlog backlog_t init(5);
   dcl buffer char(4096);
   dcl reply char(4096) varying;
   dcl msg char(256) varying;
   dcl bytes size_t;

   /* fail fast on socket errors */
   on condition(neterror) begin;
     display('server error ' || oncode());
     goto done;
   end;

   /* allow harness to kill server cleanly */
   on attention begin;
     goto done;
   end;

   /* create and bind listening socket */
   call net_open(server, AF.INET, SOCK_TYPE.STREAM, 0);
   call net_listen(server, port, backlog);
   display('server listening on ' || trim(char(port)));

   /* accept one client for this test iteration */
   call net_accept(server, client);
   display('client connected');

   /* read client request */
   bytes = net_read(client, buffer);
   if bytes = 0 then do;
     display('server no data');
     goto done_client;
   end;

   msg = substr(buffer, 1, bytes);
   display('server received ' || msg);

   /* timeout test endpoint: delay 2s for /delay */
   if index(msg, '/delay') > 0 then do;
     display('server delaying 2000ms for timeout test');
     delay(2000);
   end;

   /* serve http for GET, echo otherwise to cover both use cases */
   if index(msg, 'GET') = 1 then do;
     reply = 'HTTP/1.1 200 OK' || CR_LF ||
             'Content-Length: 27' || CR_LF ||
             'Connection: close' || CR_LF || CR_LF ||
             'Hello from PL/I test server';
     bytes = net_write(client, reply);
     display('server sent http ' || char(bytes));
   end;
   else do;
     bytes = net_write(client, msg);
     display('server echoed ' || char(bytes));
   end;

 done_client:
   /* close client connection */
   call net_close(client);
 done:
   /* close listening socket and exit */
   call net_close(server);
   display('server done');
 end main;
