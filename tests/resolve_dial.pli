 main: proc options(main);
 %include net;

   /* e2e: hostname resolution + dial by name */
   dcl conn like conncb;
   dcl conn2 like conncb;
   dcl hostname char(256) varying init('localhost');
   dcl request char(512) varying;
   dcl response char(4096);
   dcl bytes size_t;

   /* abort on any network error */
   on condition(neterror) begin;
     display('resolve_dial failed code ' || oncode());
     stop;
   end;

   /* resolve hostname to ip */
   call net_open(conn, AF.INET, SOCK_TYPE.STREAM, 0);
   call net_resolve(conn, hostname);

   if length(trim(conn.ip_addr)) = 0 then do;
     display('resolve empty ip');
     stop;
   end;

   /* localhost should resolve to loopback */
   if trim(conn.ip_addr) ^= '127.0.0.1' then do;
     display('resolve got ' || trim(conn.ip_addr));
     display(' expected 127.0.0.1');
   end;

   display('resolve ok ' || trim(conn.ip_addr));
   call net_close(conn);

   /* dial via hostname url and fetch http */
   call net_dial(conn2, 'localhost:18080', AF.INET);

   request = 'GET / HTTP/1.1' || CR_LF ||
             'Host: localhost' || CR_LF ||
             'Connection: close' || CR_LF || CR_LF;

   bytes = net_write(conn2, request);
   bytes = net_read(conn2, response);
   if bytes <= 0 then do;
     display('dial read 0');
     stop;
   end;

   /* verify server replied http */
   if index(response, '200 OK') = 0 then do;
     display('dial no 200');
     stop;
   end;

   display('dial ok');
   call net_close(conn2);
 end main;
