 main: proc options(main);
 %include net;

   dcl conn like conncb;
   dcl msg char(256) varying init('Hello PL/I echo!');
   dcl resp char(4096);
   dcl bytes size_t;

   on condition(neterror) begin;
     display('echo failed code ' || oncode());
     stop;
   end;

   call netnew(conn, AF.INET, TYPE.STREAM, 0);
   call netconnect(conn, '127.0.0.1', 18080);

   bytes = netwrite(conn, msg);
   if bytes <= 0 then do;
     display('echo write failed');
     stop;
   end;

   bytes = netread(conn, resp);
   if bytes <= 0 then do;
     display('echo no reply');
     stop;
   end;

   if substr(resp, 1, bytes) ^= msg then do;
     display('echo mismatch');
     display('got: ' || substr(resp, 1, bytes));
     display('exp: ' || msg);
     stop;
   end;

   display('echo ok');
   call netclose(conn);
 end main;
