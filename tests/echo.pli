 main: proc options(main);
 %include net;

   /* e2e: manual connect + write/read echo */
   dcl conn like conncb;
   dcl msg char(256) varying init('Hello PL/I echo!');
   dcl resp char(4096);
   dcl bytes size_t;

   /* abort on any network error */
   on condition(neterror) begin;
     display('echo failed code ' || oncode());
     stop;
   end;

   /* create socket and connect to test server */
   call net_open(conn, AF.INET, SOCK_TYPE.STREAM, 0);
   call net_connect(conn, '127.0.0.1', 18080);

   /* send payload - errors signal neterror */
   bytes = net_write(conn, msg);

   /* receive echo - 0 means eof, not signalled */
   bytes = net_read(conn, resp);
   if bytes <= 0 then do;
     display('echo no reply');
     stop;
   end;

   /* verify echo matches sent data */
   if substr(resp, 1, bytes) ^= msg then do;
     display('echo mismatch');
     display('got: ' || substr(resp, 1, bytes));
     display('exp: ' || msg);
     stop;
   end;

   display('echo ok');
   call net_close(conn);
 end main;
