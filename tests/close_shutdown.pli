 main: proc options(main);
 %include net;

   /* e2e: orderly shutdown/close and refused connect */
   dcl conn like conncb;
   dcl conn2 like conncb;
   dcl msg char(256) varying init('shutdown test');
   dcl resp char(4096);
   dcl bytes size_t;
   dcl expect_error bit(1) init('0'b);

   /* handle expected vs unexpected errors */
   on condition(neterror) begin;
     if expect_error then do;
       display('expected neterror ' || oncode() || ' ok');
       goto done;
     end;
     display('close_shutdown unexpected ' || oncode());
     stop;
   end;

   /* connect and exchange data */
   call net_open(conn, AF.INET, SOCK_TYPE.STREAM, 0);
   call net_connect(conn, '127.0.0.1', 18080);

   /* send - errors signal neterror */
   bytes = net_write(conn, msg);

   /* half-close write side - errors signal */
   call net_shutdown(conn, 1); /* 1=write */

   /* read echo before full close - 0 is eof, not signalled */
   bytes = net_read(conn, resp);

   /* close - errors signal */
   call net_close(conn);
   display('shutdown_close ok');

   /* expect refused connect on unused port */
   expect_error = '1'b;
   call net_open(conn2, AF.INET, SOCK_TYPE.STREAM, 0);
   call net_connect(conn2, '127.0.0.1', 18099);
   display('should have failed');
   stop;

 done:
   display('close_shutdown ok');
 end main;
