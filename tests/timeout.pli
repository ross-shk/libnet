 main: proc options(main);
 %include net;

   /* e2e: read timeout via direct conncb field */
   dcl conn like conncb;
   dcl request char(512) varying;
   dcl response char(4096);
   dcl bytes size_t;
   dcl expect_timeout bit(1) init('0'b);

   /* handle expected timeout vs unexpected */
   on condition(neterror) begin;
     if expect_timeout then do;
       /* EAGAIN 11 or ETIMEDOUT 110 both mean timeout on linux */
       if oncode() = 11 | oncode() = 110 | oncode() = 35 then do;
         display('timeout ok code ' || oncode());
         goto timeout_ok;
       end;
       display('timeout wrong code ' || oncode());
       goto timeout_ok;
     end;
     display('timeout unexpected ' || oncode());
     stop;
   end;

   /* helper: open, set timeout, connect */
   open_and_connect: proc(timeout);
     dcl timeout fixed bin(31);
     call net_open(conn, AF.INET, SOCK_TYPE.STREAM, 0);
     conn.read_timeout = timeout;
     display('read_timeout set ' || timeout);
     call net_connect(conn, '127.0.0.1', 18080);
   end open_and_connect;

   /* helper: build get request for path and send */
   send_get: proc(path);
     dcl path char(*) varying;
     request = 'GET ' || path || ' HTTP/1.1' || CR_LF ||
               'Host: 127.0.0.1' || CR_LF || CR_LF;
     call net_write(conn, request);
   end send_get;

   /* helper: verify response contains 200 */
   check_200: proc;
     if bytes = 0 then do;
       display('read failed');
       stop;
     end;
     if index(response, '200 OK') = 0 then do;
       display('no 200');
       stop;
     end;
   end check_200;

   /* first run - expect timeout on /delay */
   call open_and_connect(500);
   call send_get('/delay');
   expect_timeout = '1'b;
   bytes = net_read(conn, response);
   display('should have timed out');
   stop;

 timeout_ok:
   expect_timeout = '0'b;
   call net_close(conn);

   /* second run - verify without timeout still works */
   call open_and_connect(0);
   call send_get('/');
   bytes = net_read(conn, response);
   call check_200;

   display('timeout test ok with and without timeout');
   call net_close(conn);
   goto done;

 done:
 end main;
