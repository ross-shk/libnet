 main: proc options(main);
 %include net;

   /* e2e: ephemeral port 0 and peer fill */
   dcl server like conncb;
   dcl port port_t init(0);
   dcl client like conncb;
   dcl buffer char(256);
   dcl bytes size_t;

   /* handle errors */
   on condition(neterror) begin;
     display('ephemeral failed ' || oncode());
     stop;
   end;

   /* listen on 0 - kernel picks free port */
   call net_open(server, AF.INET, SOCK_TYPE.STREAM, 0);
   call net_listen(server, 0, 5);

   /* verify port was assigned */
   if server.port = 0 then do;
     display('ephemeral port still 0');
     stop;
   end;
   if server.port < 1024 | server.port > 65535 then do;
     display('ephemeral port out of range ' || server.port);
     stop;
   end;
   display('ephemeral port ' || server.port || ' ok');

   /* peer test uses fixture server on 18080 - just verify dial still works */
   call net_open(client, AF.INET, SOCK_TYPE.STREAM, 0);
   call net_connect(client, '127.0.0.1', 18080);
   display('peer connect ok to 18080');

   call net_close(client);
   call net_close(server);
   display('ephemeral ok');
 end main;
