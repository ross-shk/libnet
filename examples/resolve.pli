 /* resolve.pli — DNS resolution example for libnet.
    Module:  resolve
    Purpose: show how net_resolve maps a host name to a dotted-quad string.
    Usage:   resolve <host>
    Requires the pli-llvm wishlist (see WISHLIST.md); blocks today. */

 resolve: procedure options(main);
    %include net;

    dcl ip   char(64);
    dcl host char(256);

    on condition(net_error) begin;
       on condition(net_error) system;
       put skip list('could not resolve:', net_errtext());
       stop;
    end; /* on condition(net_error) */

    if hbound(sysparm) < 1 then host = 'localhost';
    else host = sysparm(1);

    call net_resolve(host, ip);       /* raises net_error on failure */
    put skip list(trim(host), '->', trim(ip));
 end resolve;
