  /* Copyright 2026 Ross Shkurat - Apache-2.0, see LICENSE 
    
     Minimal example of hostname resolution using net_resolve.
     Shows net_open, net_resolve and basic error handling.

     Run with:
       ./build.sh run resolve.pli
  */

  main: proc options(main);
  %include net;

    dcl conn like conncb;
    dcl hostname char(256) varying init('www.example.com');

    on condition(neterror) begin;  /* handle low-level network errors */
      display('Resolution failed, errno =' || oncode());
      stop;
    end;

    call net_open(conn, AF.INET, SOCK_TYPE.STREAM, 0);
    call net_resolve(conn, hostname);  /* hostname is auto-resolved */

    display('Resolved ' || trim(conn.host_name)
            || ' to ' || trim(conn.ip_addr));

  end;
