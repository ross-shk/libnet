  /* Copyright 2026 Ross Shkurat - Apache-2.0, see LICENSE 
    
     Minimal example of hostname resolution using netresolve.
     Shows netnew, netresolve and basic error handling.

     Run with:
       ./build.sh run resolve.pli
  */

  main: proc options(main);
  %include net;

    dcl conn like conncb;
    dcl hostname char(256) varying init('www.example.com');

    on condition(neterror) begin;  /* handle low-level network errors */
      display('Resolution failed, errno =' || oncode());
      stop;
    end;

    call netnew(conn, AF.INET, TYPE.STREAM, 0);
    call netresolve(conn, hostname);  /* hostname is auto-resolved */

    display('Resolved ' || trim(conn._host) || ' to ' || trim(conn._ip));

  end;
