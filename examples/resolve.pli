 /* resolve.pli - DNS resolution example for libnet.
    Module:  resolve
    Purpose: show how net_resolve maps a host name to an IPv4 address.
    Compiles against the compiled net module (link -lnet + libpli.a). */

 resolve: procedure options(main);
   %include net;

   dcl ip   char(16) varying;
   dcl host char(NET_HOST_MAX) varying;

   host = 'localhost';

   on condition(net_error) begin;
      on condition(net_error) system;
      put skip list('could not resolve:', net_errtext());
      stop;
   end; /* on condition(net_error) */

   call net_resolve(host, ip);
   put skip list(host, '->', ip);
 end resolve;
