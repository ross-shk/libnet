 /* fetch.pli - fetch http://example.com/ into a response buffer. */
 /* */
 /* Module:    fetch */
 /* Purpose:   Connect to example.com:80 and fetch / with */
 /*            net_read_all; failures raise conditions. */
 /* Usage:     fetch (no arguments; host is fixed) */
 /* Build:     cmake -S . -B build && cmake --build build
               cmake --build build --target libnet-examples  (trial-compile)
               ./build/fetch  (build with: plic examples/fetch.pli -I include -L build -lnet -o build/fetch) */
/* Compiles against net module (link -lnet + libpli.a): */
 /*            plic compiles with -I include and links -lnet + libpli.a */
 /*            in one step (no separate cc). */

 fetch: procedure options(main);
 %include net;

  dcl conn  pointer;
  dcl len   fixed bin(31);         /* total bytes read */
  dcl sent  fixed bin(31);
  dcl req   char(56);
  dcl body  char(*) varying controlled;

   /* ON units: each re-arms so failure inside does not recurse. */
   on condition(net_error) begin;
     on condition(net_error) system;
     put skip list('error:', net_errtext());
     stop;
   end;  /* on condition(net_error) */
   on condition(net_timeout) begin;
     on condition(net_timeout) system;
     put skip list('timeout:', net_errtext());
     stop;
   end;  /* on condition(net_timeout) */

   conn = net_open(AF_INET, SOCK_STREAM, 0);
   if conn = null() then stop;
   call net_set_timeout(conn, 10000, 10000);
   call net_connect(conn, 'example.com', 80);

  /* Exactly 56 bytes: 14+2+17+2+17+2+2, no blank padding on wire. */
  /* '0D0A'x is the CRLF pair. */
    req = 'GET / HTTP/1.0' || '0D0A'x || 'Host: example.com' ||
       '0D0A'x || 'Connection: close' || '0D0A'x || '0D0A'x;
    sent = net_send_all(conn, req);
    put skip list('sent', sent, 'request bytes');

    /* Read until EOF or signal overflow when buffer full. */
    len = net_read_all(conn, body);

   put skip list('fetched', len, 'bytes from example.com');
   if len > 0 then
     put skip list(substr(body, 1, min(len, 500)));

   call net_close(conn);
   put skip list('done');
 end fetch;
