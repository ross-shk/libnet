  /* fetch.pli — fetch http://example.com/ into an expandable buffer.
     Module:  fetch
     Purpose: connect to example.com port 80, send a minimal HTTP/1.0
              GET / request, and read the whole reply into a CONTROLLED
              buffer that doubles whenever the next chunk would not fit.
              EOF (the server closes the connection) is the normal end
              of input; every other failure arrives as a condition.
     Usage:   fetch                        (no arguments; host is fixed)
     Build:   make                                   (build libnet.a once)
              make build-prog SRC=examples/fetch.pli OUT=fetch
              ./fetch
     Compiles against the compiled net module (link -lnet + libpli.a):
              build-prog compiles this file with
              $(PLIC) -c examples/fetch.pli -I include, then links
              fetch.o with libnet.a and libpli.a.
     Needs:   adjustable CONTROLLED extents (char(cap) controlled) and
              variable-length SUBSTR — the pli-llvm wishlist libnet is
              written against (see WISHLIST.md). */

  fetch: procedure options(main);
     %include net;

     dcl conn  pointer;
     dcl done  bit(1);
     dcl cap   fixed bin(31);         /* allocated size of body */
     dcl len   fixed bin(31);         /* reply bytes stored so far */
     dcl got   fixed bin(31);         /* bytes in the last chunk */
     dcl sent  fixed bin(31);
     dcl req   char(56);
     dcl chunk char(4096);
     dcl body  char(cap) controlled;  /* the expandable buffer */
     dcl save  char(cap) controlled;  /* parking area while growing */

     /* ON units are kept to a single action, and each re-arms the
      * condition so a failure inside the unit does not recurse
      * (style guide). EOF is the normal end of the fetch loop. */
     on condition(net_error) begin;
        on condition(net_error) system;
        put skip list('error:', net_errtext());
        stop;
     end; /* on condition(net_error) */
     on condition(net_timeout) begin;
        on condition(net_timeout) system;
        put skip list('timeout:', net_errtext());
        stop;
     end; /* on condition(net_timeout) */
     on condition(net_overflow) begin;
        on condition(net_overflow) system;
        put skip list('overflow');
        stop;
     end; /* on condition(net_overflow) */
     on condition(net_eof) done = '1'b;

     /* Start small on purpose, so the doubling below can be seen. */
     cap = 512;
     len = 0;
     done = '0'b;
     allocate body;

     conn = net_open(AF_INET, SOCK_STREAM, 0);
     if conn = null() then stop;
     call net_set_timeout(conn, 10000, 10000);
     call net_connect(conn, 'example.com', 80);

     /* Exactly 56 bytes: 14 + 2 + 17 + 2 + 17 + 2 + 2, so no blank
      * padding goes on the wire. '0D0A'x is the CRLF pair. */
     req = 'GET / HTTP/1.0' || '0D0A'x || 'Host: example.com' || '0D0A'x
        || 'Connection: close' || '0D0A'x || '0D0A'x;
     sent = net_send_all(conn, req);
     put skip list('sent', sent, 'request bytes');

     /* Fetch loop: read a chunk, grow the buffer if it would not fit,
      * append the chunk. net_eof ends the loop via the ON-unit above. */
     done = '0'b;
     do while (^done);
        got = net_read(conn, chunk, maxlength(chunk));
        if got > 0 then do;
           if len + got > cap then do;
              allocate save;
              save = body;                 /* park current bytes */
              free body;
              do while (len + got > cap);
                 cap = cap * 2;
              end;
              allocate body;               /* roomier generation */
              body = save;                 /* restore; pads blanks */
              free save;
              put skip list('grew buffer to', cap, 'bytes');
           end; /* if grow */
           substr(body, len + 1, got) = substr(chunk, 1, got);
           len = len + got;
        end; /* if got > 0 */
     end; /* do while */

     put skip list('fetched', len, 'bytes from example.com');
     if len > 0 then
        put skip list(substr(body, 1, min(len, 500)));

     free body;
     call net_close(conn);
     put skip list('done');
  end fetch;
