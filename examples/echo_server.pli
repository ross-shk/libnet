 /* echo_server.pli - echo server demo for libnet (PL/I-centric). 
    
    Module:    echo_server 
    Purpose:   Listen on port 8090, accept one client, echo lines. 
    Usage:     echo_server (blocks until a client connects) 
    Compiles against the compiled net module (link -lnet + libpli.a). */

 echo_server: procedure options(main);
   %include net;

   dcl server pointer;
   dcl client pointer;
   dcl line    char(NET_BUF_CAP) varying;
   dcl got     fixed bin(31);
   dcl done    bit(1);

   /* Re-arm conditions so ON-unit failure does not recurse. */
   on condition(net_error) begin;
     on condition(net_error) system;
     put skip list('net error, code=', oncode());
     stop;
   end; /* on condition(net_error) */
   on condition(net_timeout) begin;
     on condition(net_timeout) system;
     put skip list('net timeout');
     stop;
   end; /* on condition(net_timeout) */
   on condition(net_eof) done = '1'b;

   /* Listen on 127.0.0.1:8090 */
   server = net_listen(8090, 5);
   if server = null() then stop;
   put skip list('listening on 8090');

   /* accept one client */
   call net_accept(server, client);
   put skip list('client accepted');

   /* Echo loop: read a line (net_eof ends it), write it back */
   done = '0'b;
   do while (^done);
      got = net_read_until(client, line,
         '0A'x);   /* newline delimiter */
      if ^done then call net_write(client, line);
   end; /* do while */

   call net_close(client);
   call net_close(server);
   put skip list('server done');
 end echo_server;
