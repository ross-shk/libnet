 /* simple_usage.pli - fetch using net_read_all. */
 /* */
 /* Module:    simple_usage */
 /* Purpose:   Connect to example.com:80, send GET /, */
 /*            read full reply using net_read_all. */
 /* Usage:     cmake --build build --target simple_usage
               ./build/simple_usage  (Windows: .\build\simple_usage.exe; cmake/MSBuild
               sets up the VS SDK environment automatically) */

 usage: proc options(main);
 %include net;

   dcl conn           pointer;
   dcl sent           fixed bin(31);
   dcl req            char(56);
   dcl resp           char(*) varying controlled;
   dcl total_len      fixed bin(31);

   /* ON units: re-arm so failure inside does not recurse. */
   on condition(net_error) begin;
     put skip list('error:', net_errtext());
     stop;
   end;

   /* Open connection with timeouts and connect. */
   conn = net_open(AF_INET, SOCK_STREAM, 0);
   if conn = null() then stop;
   call net_set_timeout(conn, 10000, 10000);
   call net_connect(conn, 'example.com', 80);

   /* Send HTTP/1.0 GET request with close. */
   req = 'GET / HTTP/1.0' || '0D0A'x || 'Host: example.com'
      || '0D0A'x || 'Connection: close' || '0D0A'x
      || '0D0A'x;
   sent = net_send_all(conn, req);
   put skip list('sent', sent, 'request bytes');

   /* Read entire response in one call. */
   total_len = net_read_all(conn, resp);

   /* Report fetched byte count and response text. */
   put skip list('fetched', total_len, 'bytes from example.com');
   if total_len > 0 then
     put skip list(resp);

   /* Close connection. */
   call net_close(conn);
   put skip list('done');
  end;
