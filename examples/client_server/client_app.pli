  /* Copyright 2026 Ross Shkurat - Apache-2.0, see LICENSE 
    
     Echo client example using net_open/net_connect.
     Connects to the echo server, sends a message and
     reads the echo reply. Shows net_connect, net_write,
     net_read and attention handling.

     Run with:
       ./build.sh run client_app.pli
       (needs server on 127.0.0.1:8090)
  */

  main: proc options(main);

  %include net;

   dcl conn     like conncb;
   dcl host     char(256);
   dcl port     fixed bin(31) init(8090);
   dcl request  char(256) varying;
   dcl response char(4096);
   dcl bytes    size_t;

   on attention begin;  /* allow clean shutdown on interrupt */
     call net_close(conn);
     display('Client shut down');
     stop;
   end;

   host = '127.0.0.1';
   request = 'Hello from PL/I client!' || CR_LF;

   display('Connecting to ' || trim(host) || ':' || port);

   call net_open(conn, AF.INET, SOCK_TYPE.STREAM, 0);
   call net_connect(conn, host, port);  /* connect to server */

   display('Connected');

   bytes = net_write(conn, request);  /* send message */
   display('Sent ' || bytes || ' bytes');

   bytes = net_read(conn, response);  /* read echo */
   if bytes > 0 then
     display('Received: ' || substr(response, 1, bytes));
   else
     display('No response received');

   call net_close(conn);
   display('Client done');
 end main;
