  /* Copyright 2026 Ross Shkurat - Apache-2.0, see LICENSE 
    
     Echo server example using net_open/net_listen/net_accept.
     Reads one client message and echoes it back.
     Shows net_listen, net_accept, net_read, net_write and
     attention/neterror handling.

     Run with:
       ./build.sh run server_app.pli
       (client: ./build.sh run client_app.pli)
  */

  main: proc options(main);
  %include net;

   dcl server    like conncb;
   dcl client    like conncb;
   dcl port      port_t init(8090);
   dcl backlog   backlog_t init(5);
   dcl buffer    char(4096);
   dcl message   char(256) varying;
   dcl bytes     size_t;

   on attention begin;  /* allow harness to kill server cleanly */
     call net_close(server);
     call net_close(client);
     goto done;
   end;

   on condition(neterror) begin;  /* handle low-level network errors */
     display('Socket error, code =' || oncode());
     goto done;
   end;
    
   /* create socket */
   call net_open(server, AF.INET, SOCK_TYPE.STREAM, 0);

   /* bind and listen */
   call net_listen(server, port, backlog);

   display('Server listening on port ' || port);

   /* accept one client */
   call net_accept(server, client);

   display('Client connected');

   /* read what the client sent */
   bytes = net_read(client, buffer);
   /* bytes <0 signalled via neterror, 0 is EOF */

   if bytes > 0 then do;
     message = substr(buffer, 1, bytes);
     display('Received: ' || message);

     /* echo it back */
     bytes = net_write(client, message);
     /* bytes <0 signalled */

     display('Echoed back');
   end;

   call net_close(client);
   call net_close(server);

 done:
   display('Server shut down');
 end main;
