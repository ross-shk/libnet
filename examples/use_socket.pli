 /* Copyright 2026 Ross Shkurat - Apache-2.0, see LICENSE 
    
     Manual socket example using netnew/netconnect and netwrite/netread 
     to fetch a simple HTTP response. Shows explicit host/port handling
     and basic display.              

     Run with (needs a server on 127.0.0.1:8080 or update host/port):
       ./build.sh run use_socket.pli
 */

 main: proc options(main);
 %include net;

   dcl host       char(256);
   dcl port       fixed bin(31);
   dcl request    char(2048) varying;
   dcl (bytes_sent, bytes_received) size_t;
   dcl response   char(2048);
   dcl conn like conncb;

   host = '127.0.0.1';  /* or host = 'localhost'; */
   port = 8080;
   request =
       'GET / HTTP/1.1' || CR_LF ||
       'Host: ' || trim(host) || ":" || trim(port) || CR_LF ||
       'Connection: close' || CR_LF || CR_LF;
   display("REQUEST: " || CR_LF || trim(char(request)));
   
   call netnew(conn, AF.INET, SOCK_TYPE.STREAM, 0);
   call netconnect(conn, host, port);  /* connect to host:port */

   display("       CONNECTED...");

   bytes_sent = netwrite(conn, request);  /* send request */
   display(' >> bytes sent ' || trim(char(bytes_sent)));

   bytes_received = netread(conn, response);  /* read response */
   display(' >> bytes received ' || bytes_received);
   display(' >> response ' || substr(response, 1, bytes_received));

   call netclose(conn); 
 end main;
